{
  "name": "sos-print-agent",
  "version": "1.3.0",
  "description": "Localhost print agent for SOS POS — turns a print from the browser into paper from the right printer.",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/sos-print-agent.exe",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=18"
  }
}
